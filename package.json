{
  "name": "whatsapp-sticker-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para figurinhas (imagem, vídeo e GIF) com Baileys + ffmpeg",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:sticker": "tsx scripts/test-sticker.ts"
  },
  "license": "MIT",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.10",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}

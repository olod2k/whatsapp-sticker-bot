# Prefixo dos comandos
PREFIX=!
# Nome do pacote e autor gravados na figurinha ({nome} = quem pediu)
PACK_NAME=hubberBot
AUTHOR=Feito por: {nome}
# true = só responde em grupos (como o bot original)
ONLY_GROUPS=false
# Segundos de vídeo/GIF usados na figurinha (1 a 10)
MAX_VIDEO_SECONDS=8
# Conectar por código em vez de QR: seu número com DDI, ex. 5511999998888
PAIRING_NUMBER=
# Caminho do ffmpeg (opcional; por padrão usa o ffmpeg-static ou o do sistema)
FFMPEG_PATH=
